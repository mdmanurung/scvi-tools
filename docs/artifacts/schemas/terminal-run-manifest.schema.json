{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdmanurung.github.io/cytoanvi/schemas/terminal-run-manifest-v1.json",
  "title": "Terminal scientific run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "capability_id",
    "protocol_sha256",
    "artifact",
    "expected_grid",
    "observed_grid",
    "status",
    "terminal_evidence",
    "outputs",
    "negative_results_retained"
  ],
  "properties": {
    "schema_version": {"const": "usage-readiness-terminal-run-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "wheel_sha256", "source_commit"],
      "properties": {
        "version": {"const": "0.2.0"},
        "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "expected_grid": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "observed_grid": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["terminal_success", "terminal_negative", "terminal_inconclusive", "terminal_failure", "blocked"]},
    "terminal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_backend",
        "backend_justification",
        "process_exit",
        "scheduler_accounting",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "execution_backend": {"enum": ["scheduler", "local"]},
        "backend_justification": {"type": ["string", "null"]},
        "process_exit": {"type": ["integer", "null"]},
        "scheduler_accounting": {"type": ["object", "null"], "minProperties": 1},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "negative_results_retained": {"type": "boolean"}
  }
}
